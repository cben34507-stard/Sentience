# systemd unit for the mini PC.
#   sudo cp deploy/sentience.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sentience
# Edit User= and WorkingDirectory= to match where you cloned the repo.
[Unit]
Description=Sentience life tracker (web UI + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentience
WorkingDirectory=/opt/sentience
Environment=NODE_ENV=production
Environment=PORT=4477
Environment=HOST=0.0.0.0
Environment=SENTIENCE_DATA_DIR=/opt/sentience/server/data
# After `npm run db:encrypt --workspace=server`, move data/db.key to /etc/sentience/db.key
# (owned by sentience, mode 600) and uncomment:
#Environment=SENTIENCE_DB_KEY_FILE=/etc/sentience/db.key
# Behind Tailscale serve, listen on loopback only:
#Environment=HOST=127.0.0.1
# Optional AI features:
#Environment=ANTHROPIC_API_KEY=
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/sentience/server/data
UMask=0077
ExecStart=/usr/bin/node server/dist/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
