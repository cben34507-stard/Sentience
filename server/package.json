{
  "name": "@sentience/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "db:encrypt": "tsx scripts/encrypt-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@sentience/shared": "*",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "express": "^4.21.1",
    "multer": "2.4.0",
    "sax": "^1.4.1",
    "yauzl": "^3.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/sax": "^1.2.7",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
