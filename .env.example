# Copy to .env (gitignored) or put these in the systemd unit.
PORT=4477
# 0.0.0.0 lets the phone reach it on Wi-Fi. Use 127.0.0.1 when Tailscale serve or a reverse proxy sits in front.
HOST=0.0.0.0
# SENTIENCE_DATA_DIR=/opt/sentience/server/data
# SENTIENCE_DB=/opt/sentience/server/data/sentience.sqlite

# Database encryption (run `npm run db:encrypt --workspace=server` once first).
# Point at a file outside the data folder, mode 600.
# SENTIENCE_DB_KEY_FILE=/etc/sentience/db.key
# SENTIENCE_DB_KEY=

# Serve HTTPS directly (not needed behind Tailscale serve).
# SENTIENCE_TLS_CERT=/etc/sentience/tls.crt
# SENTIENCE_TLS_KEY=/etc/sentience/tls.key

# Optional: AI meal estimates and assessments. Can also be set in the web app under Settings.
# ANTHROPIC_API_KEY=
